# --- Google: OAuth (single user's own spaces) ---
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# --- Google: service account with domain-wide delegation (whole workspace) ---
# Either a path to the JSON key or the JSON itself. Prefer `login google
# --service-account key.json --subject admin@example.com`, which stores the
# key in the OS keyring instead.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE="/path/to/service-account.json"
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
# GOOGLE_ADMIN_SUBJECT="admin@example.com"
# GOOGLE_AUTH_MODE="service-account"   # or "oauth"; default prefers the service account

# --- Pilot scope for multi-user export (CLI flags override) ---
# GOOGLE_EXPORT_USERS="a@example.com,b@example.com"
# GOOGLE_EXPORT_ORG_UNIT="/Staff"

SLACK_BOT_TOKEN="YOUR_SLACK_BOT_TOKEN"
